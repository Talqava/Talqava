{
  "name": "talqava-desktop",
  "productName": "Talqava",
  "version": "0.1.0",
  "description": "Talqava as a desktop app: run your organization with AI agents, in its own window, with nothing else to install.",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prepare-server": "node prepare-server.mjs",
    "dist": "npm run prepare-server && electron-builder --mac",
    "dist:test": "npm run prepare-server && electron-builder --mac dmg --arm64",
    "dist:win": "npm run prepare-server && electron-builder --win nsis --x64",
    "dist:linux": "npm run prepare-server && electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.talqava.agents",
    "productName": "Talqava",
    "copyright": "Copyright \u00a9 2026 GR Investments LLC",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "build/server",
        "to": "server"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Talqava",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Talqava"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Office",
      "executableName": "talqava",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "afterPack": "after-pack.cjs"
  },
  "homepage": "https://talqava.com",
  "author": "GR Investments LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talqava/Talqava.git",
    "directory": "desktop"
  },
  "overrides": {
    "minimatch@^10": "^11.0.1",
    "minimatch@^9": "^11.0.1"
  }
}
